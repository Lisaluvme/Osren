# Backend Environment Variables
# Copy this file to .env and fill in your values

# Port configuration
PORT=5000

# Google Sheets Service Account Credentials
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
# Shared Drive ID for Drive uploads (inventory images today). A Workspace Shared
# Drive is required for service-account uploads (SAs have no personal quota) —
# add the service account as a Content Manager of the Shared Drive.
GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-id
# Set to 'true' to use mock data instead of Google Sheets / Drive.
USE_MOCK_DATA=false

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Stripe Configuration (if using payment features)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Firebase Configuration (if using Firebase)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Supabase Configuration (business documents: DO / Invoice / Receipt PDFs)
# Get these from your Supabase dashboard: Project Settings -> API.
# Use the service_role key here (server-side only — never ship to the mobile app).
# Create a PUBLIC Storage bucket named `documents` before enabling.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=documents
